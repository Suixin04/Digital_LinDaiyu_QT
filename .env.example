# --- LLM (required) ---
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
CHAT_BASE_URL=https://api.deepseek.com/v1

# --- DeepSeek agent / tool calling ---
DIGITAL_LDY_ENABLE_TOOL_CALLS=1
DIGITAL_LDY_MAX_TOOL_ROUNDS=4
DEEPSEEK_THINKING=1
DEEPSEEK_REASONING_EFFORT=high       # high / max
DIGITAL_LDY_STREAM_DELAY_MS=10

# --- Retrieval (optional) ---
DIGITAL_LDY_ENABLE_RETRIEVAL=1
EMBEDDING_BACKEND=auto                # auto / dashscope / fastembed
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
DIGITAL_LDY_TOP_K=3
DIGITAL_LDY_REBUILD_KB=0
DIGITAL_LDY_STORE_AI_RESPONSE=0
DIGITAL_LDY_STORE_USER_MESSAGE=0
DIGITAL_LDY_VECTOR_DIR=knowledge_base

# --- Web server deployment ---
DIGITAL_LDY_WEB_HOST=0.0.0.0
DIGITAL_LDY_WEB_PORT=8000
DIGITAL_LDY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# --- Node frontend ---
DIGITAL_LDY_FRONTEND_MODE=dev          # dev / preview / build / none
DIGITAL_LDY_FRONTEND_HOST=0.0.0.0
DIGITAL_LDY_FRONTEND_PORT=5173

# --- Proxy (optional; useful on macOS when API/GitHub needs a local proxy) ---
# https_proxy=http://127.0.0.1:7897
# http_proxy=http://127.0.0.1:7897
# all_proxy=socks5://127.0.0.1:7897

# --- DashScope (optional: cloud embedding / ASR / CosyVoice TTS) ---
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# --- TTS (optional) ---
TTS_BACKEND=gpt_sovits                # gpt_sovits / cosyvoice / none
COSYVOICE_VOICE=longxiaochun

# --- GPT-SoVITS (本地 api_v2.py) ---
GPT_SOVITS_AUTO_START=1                                                # 0 表示外部已自行启动 api_v2
GPT_SOVITS_PRELOAD=1                                                   # Web 后端启动时提前加载 TTS，避免首句等待模型启动
GPT_SOVITS_HOST=127.0.0.1
GPT_SOVITS_PORT=9880
GPT_SOVITS_DIR=GPT-SoVITS
GPT_SOVITS_PYTHON=                                                     # 默认 GPT-SoVITS/.venv-gsv/Scripts/python.exe
GPT_SOVITS_CONFIG=GPT_SoVITS/configs/tts_infer.yaml
GPT_SOVITS_PRETRAINED_MODELS_DIR=                                      # 可选；默认 GPT-SoVITS/GPT_SoVITS/pretrained_models
GPT_SOVITS_GPT_WEIGHTS=GPT_weights_v4/digital_ldy-e15.ckpt
GPT_SOVITS_SOVITS_WEIGHTS=SoVITS_weights_v4/digital_ldy_e4_s156_l64.pth
GPT_SOVITS_REF_AUDIO=resources/samples/17.MP3
GPT_SOVITS_PROMPT_TEXT=别扫大家的兴。舅舅要是叫你，就说姨妈留你吃酒呢。
GPT_SOVITS_TEXT_LANG=zh
GPT_SOVITS_PROMPT_LANG=zh
GPT_SOVITS_FFMPEG_BIN=                                                 # 默认 GPT-SoVITS/runtime/ffmpeg/bin
GPT_SOVITS_VERSION=v4
GPT_SOVITS_STARTUP_TIMEOUT=180
GPT_SOVITS_REQUEST_TIMEOUT=300
GPT_SOVITS_WARMUP=0                                                    # CPU 服务器建议关闭；有 GPU 可设 1
GPT_SOVITS_STREAMING_MODE=1                                            # v4 会回退为分段返回；1 最稳定
GPT_SOVITS_PARALLEL_INFER=0                                            # 单句队列在 CPU 上通常关闭更稳
GPT_SOVITS_SAMPLE_STEPS=8                                              # v4 默认 32；CPU 可用 8/12/16 权衡速度与音质
