# Ubuntu / server deployment defaults.
# Copy to .env and fill DEEPSEEK_API_KEY before starting the service.

# --- LLM (required for online chat; empty key falls back to local placeholder replies) ---
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
CHAT_BASE_URL=https://api.deepseek.com/v1

# --- DeepSeek agent / tool calling ---
DIGITAL_LDY_ENABLE_TOOL_CALLS=1
DIGITAL_LDY_MAX_TOOL_ROUNDS=4
DEEPSEEK_THINKING=1
DEEPSEEK_REASONING_EFFORT=high
DIGITAL_LDY_STREAM_DELAY_MS=10

# --- Retrieval / knowledge base ---
DIGITAL_LDY_ENABLE_RETRIEVAL=1
EMBEDDING_BACKEND=fastembed
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
DIGITAL_LDY_TOP_K=3
DIGITAL_LDY_VECTOR_DIR=knowledge_base

# --- Web server ---
DIGITAL_LDY_WEB_HOST=0.0.0.0
DIGITAL_LDY_WEB_PORT=8000
DIGITAL_LDY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# --- Node frontend ---
DIGITAL_LDY_FRONTEND_MODE=dev
DIGITAL_LDY_FRONTEND_HOST=0.0.0.0
DIGITAL_LDY_FRONTEND_PORT=5173

# --- Optional proxy ---
# https_proxy=http://127.0.0.1:7897
# http_proxy=http://127.0.0.1:7897
# all_proxy=socks5://127.0.0.1:7897

# --- Optional DashScope (cloud embedding / ASR / CosyVoice TTS) ---
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# --- Optional TTS ---
# The Node Web UI can request TTS audio when this is enabled.
# Start with: bash scripts/start_web.sh --tts gpt_sovits
TTS_BACKEND=none
GPT_SOVITS_AUTO_START=0

# GPT-SoVITS paths are only used when TTS_BACKEND=gpt_sovits.
GPT_SOVITS_HOST=127.0.0.1
GPT_SOVITS_PORT=9880
GPT_SOVITS_DIR=GPT-SoVITS
GPT_SOVITS_PYTHON=
GPT_SOVITS_CONFIG=GPT_SoVITS/configs/tts_infer.yaml
GPT_SOVITS_PRETRAINED_MODELS_DIR=
GPT_SOVITS_GPT_WEIGHTS=GPT_weights_v2ProPlus/LinDaiyu-e15.ckpt
GPT_SOVITS_SOVITS_WEIGHTS=SoVITS_weights_v2ProPlus/LinDaiyu_e8_s720.pth
GPT_SOVITS_REF_AUDIO=resources/samples/17.MP3
GPT_SOVITS_PROMPT_TEXT=别扫大家的兴。舅舅要是叫你，就说姨妈留你吃酒呢。
GPT_SOVITS_TEXT_LANG=zh
GPT_SOVITS_PROMPT_LANG=zh
GPT_SOVITS_FFMPEG_BIN=
GPT_SOVITS_STARTUP_TIMEOUT=60
